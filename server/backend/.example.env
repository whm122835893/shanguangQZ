APP_DEBUG = true

DB_TYPE = mysql
DB_HOST = 127.0.0.1
DB_NAME = test
DB_USER = username
DB_PASS = password
DB_PORT = 3306
DB_CHARSET = utf8

DEFAULT_LANG = zh-cn
GANDART_SEED_PASSWORD=

# 短信验证码 HMAC 密钥（生产环境必须设置为 32 字节随机 hex）
# ⚠️ 必须是根级键，不要放进 [SMS] 分段 —— ThinkPHP 的 env() 读分段键需带 SMS. 前缀
SMS_HMAC_KEY =
# 短信通道：local=写日志（仅开发） none=关闭 其他=待实现
SMS_CHANNEL =
